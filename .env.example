# =============================================================================
# loco-arena configuration — copy to `.env` and edit:  cp .env.example .env
# Every value below is the default used when the variable is unset.
# =============================================================================

# ---- Arena mode -------------------------------------------------------------
# demo = built-in simulator, no GPU, no model download (default)
# live = call two real OpenAI-compatible servers (vLLM / Ollama / llama.cpp)
ARENA_MODE=demo

# ---- Baseline model (the "overthinker") -------------------------------------
# Running the backend directly on your machine with `make up-gpu`-style vLLM
# servers exposed on the host:   http://localhost:8001/v1
# Inside docker compose with the `gpu` profile:   http://vllm-baseline:8000/v1
# Ollama on the host, backend in Docker:          http://host.docker.internal:11434/v1
BASELINE_BASE_URL=http://localhost:8001/v1
# Model name sent in the request. vLLM: the HF repo id it serves.
# Ollama: the local tag, e.g. `deepseek-r1:7b` or `r1-baseline`.
BASELINE_MODEL=deepseek-ai/DeepSeek-R1-Distill-Qwen-7B
# Bearer token (vLLM/Ollama ignore it, but the OpenAI protocol requires one).
BASELINE_API_KEY=EMPTY

# ---- LoCo model (the concise thinker) ---------------------------------------
# Inside docker compose with the `gpu` profile:   http://vllm-loco:8000/v1
# Ollama on the host, backend in Docker:          http://host.docker.internal:11434/v1
LOCO_BASE_URL=http://localhost:8002/v1
# vLLM: HF repo id or local path of the merged LoCo model. Ollama: e.g. `loco`.
LOCO_MODEL=MuyaoYuan/LoCo-7B
LOCO_API_KEY=EMPTY

# ---- Generation defaults ----------------------------------------------------
# Default max new tokens per model (the client may override per request).
MAX_TOKENS=8192
# DeepSeek-R1 recommended sampling: temperature 0.6, top_p 0.95.
TEMPERATURE=0.6
TOP_P=0.95
# Per-request timeout in seconds (long reasoning traces can take minutes).
REQUEST_TIMEOUT=600

# ---- Backend HTTP -----------------------------------------------------------
# Comma-separated list of allowed CORS origins ("*" = any).
CORS_ORIGINS=*
# Preset problems file, relative to backend/.
PRESETS_PATH=presets.json

# =============================================================================
# GPU profile only (docker compose --profile gpu ...)
# =============================================================================

# Hugging Face token (only needed for gated/private repos; public models work without it).
HF_TOKEN=
# Fraction of each GPU's memory a vLLM server may use. 0.45 lets both servers
# share ONE GPU, which only fits two 7B bf16 models (~15 GB weights each) on
# 40 GB+ cards. On a single 24 GB GPU use AWQ/GPTQ checkpoints or run on two GPUs.
VLLM_GPU_UTIL=0.45
# Context length per vLLM server. Lower it (e.g. 8192) to shrink the KV cache.
VLLM_MAX_MODEL_LEN=16384
# CUDA device ids for each server. Same id = shared GPU; "0" and "1" = one GPU each.
BASELINE_GPU=0
LOCO_GPU=0
