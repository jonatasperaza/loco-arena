# =============================================================================
# LoCo-7B for Ollama
#
# How to produce ./loco-7b-q4_k_m.gguf (run from the repo root):
#
#   1. Merge the LoRA adapter into the base model (or download a merged LoCo):
#        make merge                      # -> training/out/loco-merged (HF safetensors)
#   2. Convert to GGUF with llama.cpp and quantize to Q4_K_M:
#        git clone https://github.com/ggml-org/llama.cpp
#        pip install -r llama.cpp/requirements.txt
#        python llama.cpp/convert_hf_to_gguf.py training/out/loco-merged \
#            --outtype f16 --outfile ollama/loco-7b-f16.gguf
#        # build llama.cpp (cmake -B build && cmake --build build -j) then:
#        llama.cpp/build/bin/llama-quantize ollama/loco-7b-f16.gguf \
#            ollama/loco-7b-q4_k_m.gguf Q4_K_M
#   3. Register it with Ollama:
#        ollama create loco -f ollama/Modelfile
#
# The template reproduces the DeepSeek-R1-Distill-Qwen chat format and pre-fills
# "<think>\n" after the assistant tag, exactly like the official HF chat template.
# No SYSTEM prompt: DeepSeek recommends putting all instructions in the user turn.
# The template intentionally does not use Ollama's `.Thinking` variables, so the
# raw <think>...</think> text is streamed in `content` and loco-arena's parser
# can split reasoning from the answer.
# =============================================================================

FROM ./loco-7b-q4_k_m.gguf

TEMPLATE """<｜begin▁of▁sentence｜>{{- if .System }}{{ .System }}{{ end }}
{{- range $i, $_ := .Messages }}
{{- $last := eq (len (slice $.Messages $i)) 1 }}
{{- if eq .Role "user" }}<｜User｜>{{ .Content }}
{{- else if eq .Role "assistant" }}<｜Assistant｜>{{ .Content }}{{- if not $last }}<｜end▁of▁sentence｜>{{- end }}
{{- end }}
{{- if and $last (ne .Role "assistant") }}<｜Assistant｜><think>
{{ end }}
{{- end }}"""

PARAMETER temperature 0.6
PARAMETER top_p 0.95
PARAMETER num_ctx 8192
PARAMETER stop "<｜end▁of▁sentence｜>"
PARAMETER stop "<｜User｜>"
